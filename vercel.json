{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/index.py": {
      "excludeFiles": "**/{scipy/{cluster,fftpack,io,odr,signal},sklearn/{_loss,cluster,compose,covariance,datasets,decomposition,ensemble,feature_selection,gaussian_process,impute,inspection,linear_model,manifold,metrics,mixture,model_selection,neighbors,svm,tests,tree}}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}